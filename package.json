{
  "name": "shiki-transformer-icon-highlight",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@10.34.7",
  "description": "Shiki transformer that highlights icons",
  "author": "Benjamin Canac <canacb1@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/benjamincanac",
  "homepage": "https://github.com/benjamincanac/shiki-transformer-icon-highlight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjamincanac/shiki-transformer-icon-highlight.git"
  },
  "bugs": "https://github.com/benjamincanac/shiki-transformer-icon-highlight/issues",
  "keywords": [
    "shiki",
    "shiki-transformer",
    "icons",
    "iconify"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "update-collections": "tsx scripts/update-collections.ts"
  },
  "dependencies": {
    "@shikijs/types": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.6.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "bumpp": "^11.1.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "shiki": "^4.5.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.3.5",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
